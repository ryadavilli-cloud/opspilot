#!/bin/sh
# Pre-commit style gate. Catches the things that were costing a lint round-trip per PR:
#   1. ruff check, which includes the 100-char E501 limit configured in pyproject.toml
#   2. em-dashes on lines this commit adds to Python files
#   3. ruff format, over the whole tree
#   4. execution-plan vocabulary outside docs/ (code guidelines section 12)
#
# Enable once per clone:
#     git config core.hooksPath .githooks
# Emergency bypass:
#     git commit --no-verify
#
# Checks 1, 3, and 4 run over the whole tree, matching what CI does, so a commit cannot pass here
# and fail there. If you stage only part of your edits, they still report on the unstaged remainder.
#
# The em-dash guard is the one deliberately scoped check: it looks only at lines this commit adds,
# because the tree still carries em-dashes in prose written before the rule and a repo-wide scan
# would reject every commit. It converges as files get edited anyway. Formatting used to be scoped
# for that same reason and no longer is, because the tree has been normalized.

set -u

status=0

# Resolve ruff: uv if installed, else the project venv, else PATH.
if command -v uv >/dev/null 2>&1; then
    ruff_cmd="uv run ruff"
elif [ -x .venv/Scripts/ruff.exe ]; then
    ruff_cmd=".venv/Scripts/ruff.exe"
elif [ -x .venv/bin/ruff ]; then
    ruff_cmd=".venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    ruff_cmd="ruff"
else
    ruff_cmd=""
fi

if [ -z "$ruff_cmd" ]; then
    echo "pre-commit: ruff not found via uv, .venv, or PATH; skipping lint."
elif ! $ruff_cmd check .; then
    echo ""
    echo "pre-commit: ruff check failed (see findings above)."
    status=1
fi

# Em-dash guard, scoped to added lines only (see header note). The pattern is built from UTF-8
# bytes rather than written literally, which also avoids depending on grep -P.
em_dash=$(printf '\342\200\224')

report=$(git diff --cached -U0 --diff-filter=ACM -- '*.py' | awk -v dash="$em_dash" '
    /^\+\+\+ / { file = substr($0, 7); next }
    /^\+/ && index($0, dash) { print "    " file ": " substr($0, 2) }
')

if [ -n "$report" ]; then
    echo "pre-commit: em-dash in added lines:"
    echo "$report"
    echo ""
    echo "pre-commit: use a hyphen, comma, colon, or a shorter sentence instead."
    status=1
fi

# Format check, over the whole tree (see header note).
if [ -n "$ruff_cmd" ]; then
    if ! $ruff_cmd format --check .; then
        echo ""
        echo "pre-commit: tree is not ruff-formatted (see above)."
        echo "pre-commit: run \`$ruff_cmd format .\`, then re-stage and commit."
        status=1
    fi
fi

# Execution-plan vocabulary outside docs/ (code guidelines section 12). Same patterns and same
# exempt list as the CI step, so this fails locally rather than after a push. The exempt modules
# are superseded machinery scheduled for deletion; they take their comments with them, and the list
# only ever shrinks. Decision identifiers are deliberately absent from the pattern: a decision is a
# settled choice the code implements, not a position in a plan.
vocab_exempt='^(src/opspilot/(api|graph|router|auth|investigations|cosmos_investigations|checkpoint|triage)\.py|src/opspilot/nodes/investigation\.py|tests/test_(api|investigations|investigations_api|auth|checkpointer|triage|triager|report_binding)\.py)$'
vocab_pattern='\bStage [0-9]|\bPhase [0-9]|\bG-[0-9]{2}|\bslices? [0-9]+\.[0-9]'

vocab=$(git ls-files | grep -vE '^docs/' | grep -vE "$vocab_exempt" \
    | xargs -r -d '\n' grep -nEH --binary-files=without-match "$vocab_pattern" 2>/dev/null || true)

if [ -n "$vocab" ]; then
    echo "pre-commit: execution-plan vocabulary outside docs/:"
    printf '%s\n' "$vocab" | sed 's/^/    /'
    echo ""
    echo "pre-commit: say what the code does and which contract it satisfies instead."
    status=1
fi

exit $status
