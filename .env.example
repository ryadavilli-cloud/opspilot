# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Keep comments on their own lines: a blank value with a trailing `# comment` is captured as the
# value by python-dotenv, so `KEY=` lines here are intentionally comment-free.

# Runtime: local | dev | prod
OPSPILOT_ENV=local

# Runtime asset paths. Blank = repo-relative default; production sets these explicitly (the
# Docker image copies the KB under /app/data and exports these).
OPSPILOT_KB_DIR=

# Retrieval backend: hybrid (dense + BM25, local/eval) | bm25 (lexical-only, runtime image default)
OPSPILOT_RETRIEVAL_BACKEND=hybrid

# Model seam. `azure` calls the chat deployment as the environment's identity; `replay` plays back
# a recorded cassette, which is what the deterministic test lane runs on.
# OPSPILOT_LLM_PROVIDER: azure | replay
OPSPILOT_LLM_PROVIDER=azure

# Reasoning effort for reasoning deployments; ignored by non-reasoning ones.
OPSPILOT_REASONING_EFFORT=medium

# Cross-vendor eval judge. DEPRECATED: superseded by D-005 (the primary chat deployment is the
# single offline judge).

# Observability span exporter: none (default) | memory (tests) | stdout (dev)
OPSPILOT_TRACE_EXPORTER=none

# Azure OpenAI. Authentication is keyless and there is no key setting: the account has local
# authentication disabled, and the client authenticates as the environment's identity (the
# Container App's managed identity in production, `az login` locally).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=
# Legacy alias name, read as a fallback for the endpoint above
AZURE_FOUNDRY_ENDPOINT=

# Deployed diagnosis implementation: deterministic | single_agent
OPSPILOT_IMPLEMENTATION=deterministic


# Durable checkpointer backend: none (default) | memory | sqlite | cosmos
OPSPILOT_CHECKPOINTER=none
OPSPILOT_CHECKPOINTER_SQLITE_PATH=.opspilot/checkpoints.sqlite

# Azure Cosmos DB (checkpointer + investigation repository). Keyless: no key setting here — the
# client falls back to DefaultAzureCredential (the Container App's managed identity).
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=opspilot
AZURE_COSMOS_CHECKPOINT_CONTAINER=checkpoints

# Investigation repository backend: memory (default, non-durable) | cosmos
OPSPILOT_INVESTIGATION_REPOSITORY=memory
AZURE_COSMOS_INVESTIGATION_CONTAINER=investigations
AZURE_COSMOS_INVESTIGATION_INDEX_CONTAINER=investigation-index

# RetailEase corpus: written by corpus preparation, read-only to the application. A separate
# database so the read-only grant is scoped once rather than per container.
AZURE_COSMOS_RETAILEASE_DATABASE=retailease
AZURE_COSMOS_KNOWLEDGE_CONTAINER=knowledge
AZURE_COSMOS_OPERATIONAL_RECORDS_CONTAINER=operational-records

# Ceiling on a single source call, in seconds. Every capability carries a deadline no greater than
# its turn's remaining time; this supplies that value until the turn controller owns it.
OPSPILOT_SOURCE_DEADLINE_SECONDS=10

# Ceiling a governed structured query's result limit must sit at or below.
OPSPILOT_STRUCTURED_QUERY_MAX_LIMIT=200

# Embedding deployment used at corpus-load time and at query time. The dimension count must match
# the knowledge container's vector policy.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Reviewer / caller identity (Entra). Tenant, audience, and all three roles are required before
# any auth-gated endpoint will serve.
AZURE_TENANT_ID=
OPSPILOT_API_AUDIENCE=
OPSPILOT_APPROVER_ROLE=Approver
OPSPILOT_SUBMIT_ROLE=Submitter
OPSPILOT_READ_ROLE=Reader
# The Entra app (client) id the operator console signs in with. Public, not a secret.
OPSPILOT_CONSOLE_CLIENT_ID=

# Ingress concurrency admission (coarse cap on concurrently running investigations)
OPSPILOT_MAX_CONCURRENT_PER_USER=3
OPSPILOT_MAX_CONCURRENT_GLOBAL=20

# Agentic loop controls
OPSPILOT_MAX_DIAGNOSE_ITERS=5
# DEPRECATED: unenforced. Reserved for reuse as the capability-call cap once something enforces it.
