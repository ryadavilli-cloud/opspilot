# Keep the build context lean — the image needs only pyproject/uv.lock/README and src/. No corpus
# data ships in the image: the KB and the operational corpus are both read from Cosmos at runtime.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.python-version

# Not needed in the image
docs
infra
.github
tests
eval
*.pdf
.vs
.vscode
.idea
out.txt
raw.txt

# Data: nothing under data/ is packaged by the Dockerfile. Corpus preparation (scripts/prepare_corpus.py)
# reads it from a full repository checkout, a separate execution context from the runtime image.
data

# Secrets / local env
.env
.env.*
!.env.example
